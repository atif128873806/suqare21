generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  googleId      String?        @unique
  image         String?
  lastActive    DateTime?
  location      String?
  loginMethod   LoginMethod    @default(EMAIL)
  preferences   Json?
  status        UserStatus     @default(ACTIVE)
  role          UserRole       @default(USER)
  sentNews      News[]         @relation("AdminNews")
  notifications Notification[]
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model News {
  id          String       @id @default(uuid())
  title       String
  content     String
  image       String?
  category    NewsCategory
  status      NewsStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  authorId    String?
  author      User?        @relation("AdminNews", fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Property {
  id          String          @id @default(uuid())
  title       String
  description String
  type        PropertyType
  purpose     PropertyPurpose
  status      PropertyStatus  @default(AVAILABLE)
  area        Float?
  areaUnit    String?
  price       Float
  priceUnit   String?
  priceType   String?
  location    String
  images      String[]
  features    String[]
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  videos      String[]
  mapHtml     String?
  leads       Lead[]
}

model Lead {
  id            String    @id @default(uuid())
  name          String
  phone         String
  email         String?
  preferredArea String?
  budget        Float?
  source        String
  propertyId    String?
  message       String?
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property? @relation(fields: [propertyId], references: [id])
}

model ChatConversation {
  id        String   @id @default(uuid())
  visitorId String   @unique
  history   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatLead {
  id           String   @id @default(uuid())
  visitorId    String   @unique
  name         String
  phone        String
  budget       String?
  area         String?
  intent       String?
  propertyType String?
  source       String   @default("chatbot")
  createdAt    DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LoginMethod {
  EMAIL
  GOOGLE
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum NewsCategory {
  MARKET_UPDATE
  INVESTMENT_TIPS
  NEW_PROJECTS
  PROPERTY_NEWS
}

enum PropertyType {
  INDUSTRIAL
  COMMERCIAL
  RESIDENTIAL
}

enum PropertyPurpose {
  RENT
  LEASE
  SALE
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
}
