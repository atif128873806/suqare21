# ---------------------------------------------------------------------------
# Square21 API — environment template
# Copy to `.env` (same directory as this file) and fill in real values.
#   cp backend/.env.example backend/.env
#
# NEVER commit the real `.env` (it is already gitignored).
# ---------------------------------------------------------------------------

# --- Runtime ----------------------------------------------------------------
# Port the NestJS API listens on. Must match the Nginx upstream and the PM2
# ecosystem file. Check it is free first:  ss -ltnp | grep :3001
PORT=3001
NODE_ENV=production

# --- Database (PostgreSQL) --------------------------------------------------
# Local Postgres on the VPS. Generate the password once and store it safely.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://square21:CHANGE_ME@127.0.0.1:5432/square21?schema=public"

# --- Auth -------------------------------------------------------------------
# Signing key for access tokens. MUST be a long random value:
#   openssl rand -hex 48
# Changing this logs every user out.
JWT_SECRET="CHANGE_ME_run__openssl_rand_hex_48"

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call the API. Comma-separated, no trailing slash.
# Every browser-side feature (properties, chatbot, signup OTP, newsletter,
# admin) is blocked for an origin that is missing here — and the symptom does
# NOT look like CORS: pages still render normally, iOS Safari reports
# "Load failed" and Chrome reports "Failed to fetch".
# The www/non-www sibling of each entry is allowed automatically, so listing
# the apex alone also covers https://www.square21marketing.com.
FRONTEND_URL="https://square21marketing.com,https://www.square21marketing.com"

# --- Email (Resend) ---------------------------------------------------------
# Used for signup OTPs and the admin newsletter. If unset, OTPs are only
# printed to the API log and newsletter sending is disabled.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- AI chatbot (Groq) ------------------------------------------------------
# Required: the API refuses to boot without it (see LangChainService).
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Media (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Legacy / unused --------------------------------------------------------
# GEMINI_API_KEY is no longer read by the code (the chatbot moved to Groq).
# Safe to omit; kept here only so nobody wonders where it went.
# GEMINI_API_KEY=""
