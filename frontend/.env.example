# ---------------------------------------------------------------------------
# Square21 web app — environment template
# Copy to `.env.local` (same directory as this file) and fill in real values.
#   cp frontend/.env.example frontend/.env.local
#
# IMPORTANT: Next.js inlines every NEXT_PUBLIC_* value at BUILD time.
# Changing NEXT_PUBLIC_API_URL therefore requires a rebuild (`npm run build`),
# not just a restart — this is the single most common cause of a "deployed but
# the site can't reach the API" incident.
# ---------------------------------------------------------------------------

# --- Backend API ------------------------------------------------------------
# Public URL that BROWSERS use. With the Nginx setup in deploy/nginx, the API
# is exposed under https://square21marketing.com/api.
# Server components use the same value, so requests leave the box, hit Nginx
# and come back — that is expected (and why the API rate limiter must not
# throttle loopback traffic, see DEPLOY.md "Known issues").
#
# POLICY: the hostname here must also be allowed by the API's FRONTEND_URL
# (backend/.env). If this app is served on a second hostname (for example
# www.square21marketing.com), calling this absolute apex URL from that origin
# is a cross-origin request — and if the API does not allow that origin, every
# client-side call fails (iOS Safari: "Load failed", Chrome: "Failed to
# fetch") while server-rendered pages keep working. Either keep both hosts in
# the API allowlist or redirect www to the apex.
NEXT_PUBLIC_API_URL=https://square21marketing.com/api

# --- NextAuth ---------------------------------------------------------------
# Public origin of THIS app. No trailing slash.
NEXTAUTH_URL=https://square21marketing.com
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_run__openssl_rand_base64_32"

# --- Google OAuth -----------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 client.
# Authorised redirect URI must be exactly:
#   https://square21marketing.com/api/auth/callback/google
# (Register a second URI only if you really serve www as a separate origin.)
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"

# --- Legacy / unused --------------------------------------------------------
# AUTH_SECRET is a NextAuth v5 variable; this app runs NextAuth v4 and reads
# NEXTAUTH_SECRET. Harmless if present, not required.
# AUTH_SECRET=""
